{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["app/**/*", "src/**/*", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
